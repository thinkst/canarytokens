<!--
  This is an MJML file. MJML (Mailjet Markup Language) is a markup language designed to reduce the pain of coding responsive email templates.
  It abstracts away the complexity of responsive email design, allowing developers to write simpler and more readable code.

  There are many ways you can use MJML. The easier one that requires less setup is:
  1. Add a mjml plugin to your code editor. This will allow you to write MJML code and see the rendered email template in real-time.
    For VScode https://marketplace.visualstudio.com/items?itemName=attilabuti.vscode-mjml
    ( If you face troubles with the official plugin, try one of the forked projects )
  2. Use the MJML online editor to convert mjml code to html: https://mjml.io/try-it-live

  Or install MJML globally and compile your MJML files into HTML files:
  1. Install MJML: `npm install -g mjml`.
  2. Create an MJML file: Write your email template using MJML tags.
  3. Compile the MJML file: Use the command `mjml input.mjml -o output.html` to compile your MJML file into an HTML file.
  4. Use the generated HTML: The output HTML file can be used in your email campaigns.


  For more information, and more visit the official MJML documentation: https://mjml.io/documentation

  NOTE: When exporting to html, the conditions {% if BasicDetails['something'] %} living outside a <mj-text> are not supported and will be removed from the final html file.
  If you need to use conditions, remeber to check the output html file and add them manually if needed.
-->
<mjml>
  <mj-head>
    <mj-title>Your Credit Card Canarytokens Expire This Month</mj-title>
    <mj-attributes>
      <mj-all font-family="'Helvetica Neue', Helvetica, Arial, sans-serif"></mj-all>
      <mj-text font-weight="400" font-size="16px" color="#4D4D4D" line-height="24px" font-family="'Helvetica Neue', Helvetica, Arial, sans-serif"></mj-text>
    </mj-attributes>
    <mj-style inline="inline">
        .token-table__header-cell {
            padding: 12px 16px;
            color: #818A8E;
            font-size: 14px;
            font-weight: 400;
            line-height: 18px;
            text-align: left;
        }

        .token-table__cell {
            padding: 16px;
            color: #060606;
            font-size: 16px;
            font-weight: 400;
            line-height: 21px;
            text-align: left;
        }

        .token-table__cell--bordered {
            border-top: 1px solid #D7D7D7;
        }

        .token-table__cell--strong {
            font-weight: 500;
        }

        .token-table__cell--action {
            text-align: right;
        }

        .token-table__mobile-label {
            display: none;
            color: #818A8E;
            font-size: 12px;
            font-weight: 400;
            line-height: 16px;
        }

        .token-table__button {
            display: inline-block;
            padding: 8px 16px;
            border-radius: 16px;
            color: #fff;
            background-color: #FFA72D;
            font-size: 14px;
            font-weight: 500;
            line-height: 18px;
            text-decoration: none;
        }

    </mj-style>
    <mj-style>
        @media only screen and (max-width: 480px) {
            .token-table,
            .token-table table,
            .token-table tbody,
            .token-table tr,
            .token-table td {
                display: block !important;
                width: 100% !important;
                box-sizing: border-box !important;
            }

            .token-table thead {
                display: none !important;
            }

            .token-table tr {
                padding: 12px 0 !important;
                border-top: 1px solid #D7D7D7 !important;
            }

            .token-table__cell {
                padding: 4px 16px !important;
                border-top: 0 !important;
            }

            .token-table__mobile-label {
                display: block !important;
                padding-bottom: 2px !important;
            }

            .token-table__cell--action {
                padding-top: 12px !important;
                text-align: left !important;
            }
        }
    </mj-style>
  </mj-head>

  <mj-body background-color="#F6F7FA" width="800px">
    <mj-section padding="10px 0 20px 0">
      <mj-column>
      </mj-column>
    </mj-section>

    <!-- Red bar top -->
    <mj-section padding="10px 0 0px 0px" border-radius="30px 30px 0 0" background-color="#38D07E">
      <!--Logo -->
      <mj-column width="40%">
        <mj-image src="https://{{ public_domain }}/resources/notification-email/token_logo.png" alt="Canarytokens" align="center" border="none" padding="0px" height="94px" />
      </mj-column>
    </mj-section>


    <mj-wrapper padding="30px 30px 0px 30px" background-color="#FFF">
      <!--Alert Top details -->
      <mj-section padding="20px 0px 0px" border-radius="16px 16px" background-color="#F6F7FA">
        <mj-column background-color="#f6f8fb" padding-bottom="30px" border-radius="0 0 16px 16px"
        >
        <mj-image src="https://{{ public_domain }}/resources/notification-email/cc_expired_token/cc_token_expired.png" alt="Canarytokens" align="center" border="none" padding="8px" height="70px" width="70px"/>

          <mj-text color="#060606" font-weight="bold" align="center" font-size="24px" line-height="32px">
            Your Credit Card Canarytoken<br /> will expire soon.</mj-text>
          <mj-text color="#818a8e" padding="20px 50px 0 50px" align="center">
           These tokens use real credit card details, and like all credit cards, they eventually expire.
          </mj-text>
          <mj-text color="#818a8e" padding="0px 50px" align="center" padding-top="20px">
            Once a token reaches its expiration date, it will no longer generate alerts if the card details are used.
          </mj-text>
        </mj-column>
      </mj-section>
    </mj-wrapper>

    <!-- Token Link -->
    <mj-wrapper padding="24px 30px 0px" background-color="#FFF">
      <mj-section background-color="#f6f8fb" border-radius="12px" padding="20px 20px">
        <mj-column>
          <mj-text color="#060606" font-weight="bold" align="center" font-size="24px" line-height="32px">
            Expiring Tokens</mj-text>
            <mj-table css-class="token-table" padding="24px 0px 0px">
                <thead>
                    <tr>
                        <th scope="col" class="token-table__header-cell">Reminder</th>
                        <th scope="col" class="token-table__header-cell">Expires</th>
                        <th scope="col" class="token-table__header-cell"></th>
                    </tr>
                </thead>
                <tbody>
                {% for card in cards %}
                <tr>
                    <td class="token-table__cell token-table__cell--bordered" data-label="Reminder"><span class="token-table__mobile-label">Reminder</span>{{ card.memo }}</td>
                    <td class="token-table__cell token-table__cell--bordered token-table__cell--strong" data-label="Expires"><span class="token-table__mobile-label">Expires</span>{{ card.cc_v2_expiry_month }}/{{ card.cc_v2_expiry_year }}</td>
                    <td class="token-table__cell token-table__cell--bordered token-table__cell--action">
                        <a href="{{ card.build_manage_url(switchboard_scheme, public_domain) }}" target="_blank" class="token-table__button">View token</a>
                    </td>
                </tr>
                {% endfor %}
                </tbody>
            </mj-table>
        </mj-column>
      </mj-section>
    </mj-wrapper>

    <!-- What's next -->
    <mj-wrapper padding="24px 30px 0px" background-color="#FFF">
      <mj-section background-color="#f6f8fb" border-radius="12px" padding="16px 16px">
        <mj-column width="15%">
         <mj-image src="https://{{ public_domain }}/resources/notification-email/cc_expired_token/whats_next.png" alt="Canarytokens" align="center" border="none" padding="8px 0px 0px 0px" height="50px" width="50px"/>
        </mj-column>
        <mj-column width="80%">
            <mj-text color="#060606" font-weight="bold" align="left" font-size="24px" padding-bottom="24px" padding-top="16px">
            What next?
            </mj-text>
            <mj-text color="#818a8e" align="left" padding-top="0">
            To continue receiving alerts, simply create a new Credit Card Canarytoken at Canarytokens.org and replace the expiring
            token in your environment.
            </mj-text>
        </mj-column>
      </mj-section>
    </mj-wrapper>

    <!-- Nedd more  -->
    <mj-wrapper padding="24px 30px 0px" background-color="#FFF">
      <mj-section background-color="#B5EDCF" border-radius="12px" padding="20px 20px">
        <mj-column width="15%">
            <mj-image src="https://{{ public_domain }}/resources/notification-email/cc_expired_token/canarytokens_icon.png" alt="Canarytokens" align="center" border="none" padding="0px 0px 0px 0px" height="70px" width="70px"/>
        </mj-column>
          <mj-column width="80%">
            <mj-text color="#060606" font-weight="bold" align="left" font-size="24px" padding-bottom="24px" padding-top="16px">
            Need more?
            </mj-text>
            <mj-text color="#060606" align="left" padding-top="0">
           If you're managing multiple Canarytokens or would like centralized visibility and administration, consider using the Thinkst Canary Console!
            </mj-text>
        </mj-column>
      </mj-section>
    </mj-wrapper>


    <!-- Banner ad -->
    <mj-wrapper padding="0px 30px 30px" background-color="#FFF" border-radius="0 0 60px 60px"></mj-wrapper>
    <mj-wrapper padding="0px 30px 30px" background-color="#F6F7FA"></mj-wrapper>

    <mj-wrapper padding="10px 30px" background-color="#38d07e" border-radius="30px">
      <mj-section padding="20px 0 10px 0">
        <mj-column>
          <mj-text align="center" color="white" font-size="24px" padding="10px 30px">
            Some of the <span style="font-weight:600">best security teams</span> in the world run <span style="font-weight:600">Thinkst Canary</span>.
          </mj-text>
          <mj-text align="center" color="white">
            <a href="https://canary.tools/why" style="color:white">Find out why</a>
          </mj-text>
        </mj-column>
      </mj-section>
    </mj-wrapper>

    <mj-wrapper padding="0px 30px 30px" background-color="#F6F7FA"></mj-wrapper>


  </mj-body>
</mjml>
